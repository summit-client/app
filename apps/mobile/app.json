{
  "expo": {
    "name": "Summit",
    "slug": "summit-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "summit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.summitclient.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b5a6e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
