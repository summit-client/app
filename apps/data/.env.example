# Clinician portal (apps/data) — port 3002, per nginx data.summitclient.io
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fixture mode: runs every screen on seed data with NO database and NO LOGIN.
# 0 in every checked-in example. The proxy additionally refuses to honour this
# when NODE_ENV=production, so it cannot open the portal on the droplet.
# Kept NEXT_PUBLIC_ because layout.tsx renders the "Preview data" pill client-side.
NEXT_PUBLIC_DEV_PREVIEW=0

# --- Clinical AI (server-side ONLY; never NEXT_PUBLIC_*) ---------------------
# Off by default. Turn on per environment, deliberately.
CLINICAL_AI_ENABLED=false
CLINICAL_AI_PROVIDER=azure_openai
# PHI must be enabled explicitly, per environment, once the BAA is confirmed.
CLINICAL_AI_ALLOW_PHI=false
AI_NOTE_SYNTHESIS_ENABLED=false
AI_PROGRESS_REPORTS_ENABLED=false
AI_TREATMENT_PLANNING_ENABLED=false
AI_DECISION_SUPPORT_ENABLED=false
# Azure OpenAI (production PHI provider, under the organization BAA)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
# Anthropic (synthetic/dev + non-PHI only; PHI refused unless formally approved)
CLINICAL_AI_ANTHROPIC_KEY=
AI_ANTHROPIC_PHI_APPROVED=false
