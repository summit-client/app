# Clinician portal (apps/data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to run every screen on seeded fixtures with no database or login:
NEXT_PUBLIC_DEV_PREVIEW=1

# --- Clinical AI (server-side ONLY; never NEXT_PUBLIC_*) ---------------------
CLINICAL_AI_ENABLED=true
CLINICAL_AI_PROVIDER=azure_openai
CLINICAL_AI_ALLOW_PHI=true
AI_NOTE_SYNTHESIS_ENABLED=true
AI_PROGRESS_REPORTS_ENABLED=true
AI_TREATMENT_PLANNING_ENABLED=true
AI_DECISION_SUPPORT_ENABLED=true
# Azure OpenAI (production PHI provider, under the organization BAA)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
# Anthropic (synthetic/dev + non-PHI only; PHI refused unless formally approved)
CLINICAL_AI_ANTHROPIC_KEY=
AI_ANTHROPIC_PHI_APPROVED=false
